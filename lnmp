#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -r /etc/lnmp-debian.conf ]]; then
    # shellcheck disable=SC1091
    . /etc/lnmp-debian.conf
elif [[ -r "${SCRIPT_DIR}/lnmp-debian.conf" ]]; then
    # shellcheck disable=SC1091
    . "${SCRIPT_DIR}/lnmp-debian.conf"
fi

NGINX_CONF=/etc/nginx
VHOST_DIR="${NGINX_CONF}/sites-available"
ENABLED_VHOST_DIR="${NGINX_CONF}/sites-enabled"
SSL_DIR="${NGINX_CONF}/ssl"
REWRITE_DIR="${NGINX_CONF}/rewrite"
WEB_ROOT="${WEB_ROOT:-/home/wwwroot}"
DEFAULT_WEB_ROOT="${DEFAULT_WEB_ROOT:-${WEB_ROOT}/default}"
NGINX_LOG_DIR="${NGINX_LOG_DIR:-/var/log/nginx}"
ACME_HOME=/usr/local/acme.sh
# 证书目录（--certhome / --cert-home）指向 Nginx SSL 目录：证书由 acme.sh
# 直接写到 <cert-home>/<域名>/，即历史路径 /etc/nginx/ssl/<域名>/，无需再复制。
# 配置与账户密钥仍留在 acme.sh 默认配置目录；ACME_HOME 是程序目录（--home）。
ACME_CERT_HOME="${SSL_DIR}"
ACME_BIN="$(command -v acme.sh || true)"
is_supported_php_version() {
    local major
    [[ "$1" =~ ^([0-9]+)\.[0-9]+$ ]] || return 1
    major="${BASH_REMATCH[1]}"
    (( 10#$major >= 8 ))
}

PHP_FPM_VERSION=
if [[ -r /etc/lnmp-debian/php-version ]]; then
    IFS= read -r PHP_FPM_VERSION < /etc/lnmp-debian/php-version || true
fi
if ! is_supported_php_version "$PHP_FPM_VERSION"; then
    PHP_FPM_VERSION="${PHP_VERSION:-}"
fi
if ! is_supported_php_version "$PHP_FPM_VERSION"; then
    PHP_FPM_VERSION="$(php -r 'echo PHP_MAJOR_VERSION, ".", PHP_MINOR_VERSION;' 2>/dev/null || true)"
fi
if ! is_supported_php_version "$PHP_FPM_VERSION"; then
    PHP_FPM_VERSION=
    for php_fpm_dir in /etc/php/*/fpm; do
        [[ -d "$php_fpm_dir" ]] || continue
        php_candidate="${php_fpm_dir#/etc/php/}"
        php_candidate="${php_candidate%/fpm}"
        if is_supported_php_version "$php_candidate"; then
            if [[ -n "$PHP_FPM_VERSION" ]]; then
                PHP_FPM_VERSION=
                break
            fi
            PHP_FPM_VERSION=$php_candidate
        fi
    done
fi

usage() {
    cat <<'EOF'
Usage:
  lnmp {start|stop|reload|restart|kill|status}
  lnmp {nginx|mysql|mariadb|php-fpm} {start|stop|reload|restart|kill|status}
  lnmp vhost {add|list|del}
  lnmp addons {install|uninstall} <addon>
  lnmp ssl {add|auto-renew}
  lnmp {dnsssl|dns|onlyssl} {ali|cf|dp|he|gd|aws|namecheap|namesilo}
EOF
}

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

require_root() {
    [[ "$(id -u)" -eq 0 ]] || fail "Run this command as root."
}

require_nginx() {
    [[ -x /usr/sbin/nginx && -d "$VHOST_DIR" && -d "$ENABLED_VHOST_DIR" ]] ||
        fail "LNMP Debian is not installed. Run lnmp-Debian/install.sh first."
}

valid_domain() {
    [[ "$1" =~ ^(\*\.)?[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]]
}

reload_nginx() {
    printf 'Testing Nginx configuration...\n'
    /usr/sbin/nginx -t
    printf 'Reloading Nginx...\n'
    systemctl reload nginx
    printf 'Nginx reloaded.\n'
}

service_action() {
    local action=$1 service=$2
    [[ "$action" != kill ]] || action=stop
    local unit label state verb completed
    case "$service" in
        nginx) unit=nginx; label=Nginx ;;
        mysql|mariadb) unit=mysql; label=MySQL ;;
        php-fpm)
            [[ -n "$PHP_FPM_VERSION" ]] || fail "Could not determine the installed PHP-FPM version."
            if [[ -r /etc/lnmp-debian/php-upstream-service ]]; then
                IFS= read -r unit < /etc/lnmp-debian/php-upstream-service || true
                [[ "$unit" == lnmp-php-upstream ]] ||
                    fail "Unknown PHP-FPM service configured in /etc/lnmp-debian/php-upstream-service."
            else
                unit="php${PHP_FPM_VERSION}-fpm"
            fi
            label=PHP-FPM
            ;;
        *) fail "Unknown service: $service" ;;
    esac
    if [[ "$action" == status ]]; then
        state="$(systemctl is-active "$unit" 2>/dev/null || true)"
        printf '%-8s %s\n' "${label}:" "${state:-unknown}"
    else
        case "$action" in
            start) verb=Starting; completed=started ;;
            stop) verb=Stopping; completed=stopped ;;
            restart) verb=Restarting; completed=restarted ;;
            reload) verb=Reloading; completed=reloaded ;;
            *) fail "Unsupported service action: $action" ;;
        esac
        printf '%s %s...\n' "$verb" "$label"
        systemctl daemon-reload
        systemctl "$action" "$unit"
        printf '%s %s.\n' "$label" "$completed"
    fi
}

service_bundle() {
    local action=$1 service
    printf 'LNMP: %s services\n' "$action"
    for service in nginx mysql php-fpm; do
        service_action "$action" "$service"
    done
    printf 'LNMP service group %s complete.\n' "$action"
}

create_vhost_config() {
    local domain=$1 names=$2 webroot=$3 rewrite=$4 php_config=$5 ipv6_listen=$6 access_log=$7
    local config="${VHOST_DIR}/${domain}.conf"
    local enabled_config="${ENABLED_VHOST_DIR}/${domain}.conf"
    [[ ! -e "$config" && ! -L "$config" && ! -e "$enabled_config" && ! -L "$enabled_config" ]] ||
        fail "Virtual host already exists: $domain"
    [[ "$webroot" == /* && "$webroot" =~ ^/[A-Za-z0-9_./-]+$ ]] ||
        fail "Web root must be an absolute path using only letters, digits, dot, underscore, slash, or hyphen."
    [[ "$rewrite" =~ ^[A-Za-z0-9_-]+$ ]] || fail "Invalid rewrite profile name."
    [[ "$php_config" == enable-php.conf || "$php_config" == enable-php-pathinfo.conf ]] ||
        fail "Invalid PHP configuration."
    if [[ ! -e "${REWRITE_DIR}/${rewrite}.conf" && ! -L "${REWRITE_DIR}/${rewrite}.conf" ]]; then
        : > "${REWRITE_DIR}/${rewrite}.conf"
        printf 'Created custom rewrite file: %s\n' "${REWRITE_DIR}/${rewrite}.conf"
    fi

    if [[ ! -d "$webroot" ]]; then
        mkdir -p "$webroot"
        chown www:www "$webroot"
    fi
    cat > "$config" <<EOF
server
{
    listen 80;
    ${ipv6_listen}
    server_name ${names};
    index index.html index.htm index.php;
    root ${webroot};

    include rewrite/${rewrite}.conf;
    include snippets/${php_config};

    location ~* \.(gif|jpe?g|png|bmp|swf|ico|webp)$ {
        expires 30d;
    }

    location ~* \.(js|css)$ {
        expires 12h;
    }

    location ~ /.well-known {
        allow all;
    }

    location ~ /\\. {
        deny all;
    }

    ${access_log}
}
EOF
    ln -s "../sites-available/${domain}.conf" "$enabled_config"
    if ! reload_nginx; then
        rm -f "$enabled_config"
        rm -f "$config"
        fail "Nginx rejected the new virtual host; its config was removed."
    fi
    printf 'Virtual host created: %s\nWeb root: %s\n' "$domain" "$webroot"
}

add_vhost() {
    local domain more_names webroot rewrite allow_rewrite pathinfo_choice php_config
    local ipv6_choice ipv6_listen access_choice access_line name
    local ssl_choice ssl_source ssl_cert ssl_key ssl_ca
    local -a additional_names rewrite_profiles
    require_root
    require_nginx
    read -r -p "Please enter domain (example: www.example.com): " domain
    valid_domain "$domain" || fail "Invalid domain name."
    [[ ! -e "${VHOST_DIR}/${domain}.conf" ]] || fail "Virtual host already exists: $domain"

    read -r -p "Enter additional domain names (optional): " more_names
    read -r -a additional_names <<< "$more_names"
    for name in "${additional_names[@]}"; do
        valid_domain "$name" || fail "Invalid additional domain name: $name"
    done
    read -r -p "Web root [${WEB_ROOT}/${domain}]: " webroot
    webroot="${webroot:-${WEB_ROOT}/${domain}}"
    read -r -p "Enable pseudo-static rewrite rules? [y/N]: " allow_rewrite
    if [[ "$allow_rewrite" =~ ^[Yy]$ ]]; then
        mapfile -t rewrite_profiles < <(
            find "$REWRITE_DIR" -maxdepth 1 -type f -name '*.conf' -print |
                sed 's#^.*/##; s/\.conf$//' | sort
        )
        printf 'Available rewrite profiles:\n'
        printf '  %s\n' "${rewrite_profiles[@]}"
        read -r -p "Rewrite profile [other]: " rewrite
        rewrite="${rewrite:-other}"
    else
        rewrite=none
    fi
    [[ "$rewrite" =~ ^[A-Za-z0-9_-]+$ ]] || fail "Invalid rewrite profile name."
    printf 'Using rewrite profile: %s\n' "$rewrite"

    read -r -p "Enable PHP Pathinfo? [y/N]: " pathinfo_choice
    if [[ "$pathinfo_choice" =~ ^[Yy]$ ]]; then
        php_config=enable-php-pathinfo.conf
    else
        php_config=enable-php.conf
    fi
    read -r -p "Enable IPv6 listener? [y/N]: " ipv6_choice
    if [[ "$ipv6_choice" =~ ^[Yy]$ ]]; then
        ipv6_listen='listen [::]:80;'
    else
        ipv6_listen=
    fi

    read -r -p "Enable access log? [Y/n]: " access_choice
    if [[ "$access_choice" =~ ^[Nn]$ ]]; then
        access_line="access_log off;"
    else
        mkdir -p "$NGINX_LOG_DIR"
        touch "${NGINX_LOG_DIR}/${domain}.log"
        access_line="access_log ${NGINX_LOG_DIR}/${domain}.log;"
    fi

    create_vhost_config "$domain" "$domain $more_names" "$webroot" "$rewrite" \
        "$php_config" "$ipv6_listen" "$access_line"

    read -r -p "Add an SSL certificate now? [y/N]: " ssl_choice
    [[ "$ssl_choice" =~ ^[Yy]$ ]] || return 0
    printf "1: Let's Encrypt\n"
    printf '2: ZeroSSL\n'
    read -r -p "Enter 1 or 2: " ssl_source
    case "$ssl_source" in
        1) ssl_ca=letsencrypt ;;
        2) ssl_ca=zerossl ;;
        *) fail "Choose 1 or 2." ;;
    esac
    [[ "$domain" != \*.* ]] || fail "Wildcard certificates require lnmp dnsssl."
    CERT_DOMAIN="$domain"
    CERT_MORE="$more_names"
    # 新 vhost 的 webroot 已知，直接使用，不重复询问。
    issue_certificate webroot "" "$ssl_ca" "$webroot"
    ssl_cert="${SSL_DIR}/${domain}/fullchain.cer"
    ssl_key="${SSL_DIR}/${domain}/${domain}.key"
    print_config_hint "$ssl_cert" "$ssl_key"
}

list_vhosts() {
    require_nginx
    printf 'Nginx Virtualhost list:\n'
    find "$ENABLED_VHOST_DIR" -maxdepth 1 -type l -name '*.conf' ! -name default.conf -print |
        sed 's#^.*/##; s/\.conf$//' | sort
}

delete_vhost() {
    local domain backup config enabled_config
    require_root
    require_nginx
    list_vhosts
    read -r -p "Please enter domain you want to delete: " domain
    valid_domain "$domain" || fail "Invalid domain name."
    config="${VHOST_DIR}/${domain}.conf"
    enabled_config="${ENABLED_VHOST_DIR}/${domain}.conf"
    [[ -f "$config" ]] || fail "Virtual host does not exist: $domain"
    [[ -L "$enabled_config" && "$(readlink -f "$enabled_config")" == "$(readlink -f "$config")" ]] ||
        fail "Virtual host is not enabled through the Debian sites-enabled directory: $domain"
    backup="$(mktemp)"
    mv -- "$config" "$backup"
    rm -- "$enabled_config"
    if ! reload_nginx; then
        mv "$backup" "$config"
        ln -s "../sites-available/${domain}.conf" "$enabled_config"
        fail "Nginx rejected the change; the virtual host config was restored."
    fi
    rm -f "$backup"
    printf 'Domain config deleted. Website files were not removed: %s\n' "$domain"
}

collect_cert_domains() {
    local name
    local -a additional_names
    read -r -p "Please enter domain: " CERT_DOMAIN
    valid_domain "$CERT_DOMAIN" || fail "Invalid domain name."
    read -r -p "Enter additional domain names (optional): " CERT_MORE
    read -r -a additional_names <<< "$CERT_MORE"
    for name in "${additional_names[@]}"; do
        valid_domain "$name" || fail "Invalid additional domain name: $name"
    done
    CERT_NAMES="$CERT_DOMAIN"
    [[ -z "$CERT_MORE" ]] || CERT_NAMES+=" $CERT_MORE"
}

collect_email() {
    read -r -p "Email address for certificate expiry notices: " CERT_EMAIL
    [[ "$CERT_EMAIL" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] ||
        fail "A valid email address is required."
}

# 从已有 vhost 配置中读取 root，避免证书签发流程再询问站点目录。
vhost_webroot() {
    local domain=$1 config="${VHOST_DIR}/${1}.conf" webroot
    [[ -f "$config" ]] || fail "Virtual host not found: $domain. Create it first with: lnmp vhost add"
    webroot="$(awk '/^[[:space:]]*root[[:space:]]+/ {print $2; exit}' "$config" | tr -d ';')"
    [[ -n "$webroot" ]] || fail "Could not find a root directive in $config."
    printf '%s\n' "$webroot"
}

print_cert_paths() {
    printf 'Certificate: %s\nPrivate key: %s\n' "$1" "$2"
}

# 证书流程只落盘证书，不改写 vhost；明确提示用户自行添加 HTTPS 配置。
print_config_hint() {
    printf 'Nginx configuration was not modified. To enable HTTPS, add a 443 server block to the vhost with:\n'
    printf '    ssl_certificate %s;\n' "$1"
    printf '    ssl_certificate_key %s;\n' "$2"
    printf 'Then check and reload Nginx yourself: nginx -t && systemctl reload nginx\n'
}

ensure_acme_renewal_timer() {
    local service_file=/etc/systemd/system/lnmp-acme-renew.service
    local timer_file=/etc/systemd/system/lnmp-acme-renew.timer
    [[ "$ACME_BIN" == /* && "$ACME_BIN" != *[[:space:]]* ]] ||
        fail "acme.sh must resolve to an absolute path without whitespace."
    cat > "$service_file" <<EOF
[Unit]
Description=Renew LNMP ACME certificates
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=${ACME_BIN} --cron --home ${ACME_HOME} --certhome ${ACME_CERT_HOME}
EOF
    cat > "$timer_file" <<'EOF'
[Unit]
Description=Daily renewal check for LNMP ACME certificates

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF
    chmod 0644 "$service_file" "$timer_file"
    systemctl daemon-reload
    systemctl enable --now lnmp-acme-renew.timer
}

issue_certificate() {
    local challenge=$1 provider=${2:-} ca=$3 webroot=${4:-}
    local name dns_plugin cert_dir cert key
    local -a domain_args additional_names
    [[ -n "$ACME_BIN" ]] || fail "acme.sh is missing; install the Debian package with apt."
    [[ -n "${CERT_EMAIL:-}" ]] || collect_email
    ensure_acme_renewal_timer
    mkdir -p "$ACME_HOME" "$ACME_CERT_HOME"
    domain_args=(-d "$CERT_DOMAIN")
    read -r -a additional_names <<< "$CERT_MORE"
    for name in "${additional_names[@]}"; do
        domain_args+=(-d "$name")
    done

    if [[ "$challenge" == webroot ]]; then
        [[ "$CERT_DOMAIN" != \*.* ]] || fail "Wildcard certificates require DNS validation."
        # 不询问目录：显式传入的 webroot 优先，否则从已有 vhost 的 root 读取。
        [[ -n "$webroot" ]] || webroot="$(vhost_webroot "$CERT_DOMAIN")"
        [[ -d "$webroot" ]] || fail "Web root does not exist: $webroot"
        "$ACME_BIN" --home "$ACME_HOME" --register-account -m "$CERT_EMAIL" --server "$ca"
        "$ACME_BIN" --home "$ACME_HOME" --certhome "$ACME_CERT_HOME" --issue --server "$ca" \
            "${domain_args[@]}" --webroot "$webroot" --keylength 2048 \
            --renew-hook "systemctl reload nginx"
    else
        if [[ -n "$provider" ]]; then
            dns_plugin="dns_${provider}"
        else
            fail "DNS provider is required for DNS validation."
        fi
        "$ACME_BIN" --home "$ACME_HOME" --register-account -m "$CERT_EMAIL" --server "$ca"
        "$ACME_BIN" --home "$ACME_HOME" --certhome "$ACME_CERT_HOME" --issue --server "$ca" \
            "${domain_args[@]}" --dns "$dns_plugin" --keylength 2048 \
            --renew-hook "systemctl reload nginx"
    fi

    # 证书由 acme.sh 直接写入 <cert-home>/<域名>/，即历史路径 /etc/nginx/ssl/<域名>/，
    # 无需 --install-cert 复制；续签后的 reload 由签发时的 --renew-hook 负责。
    cert_dir="${ACME_CERT_HOME}/${CERT_DOMAIN}"
    cert="${cert_dir}/fullchain.cer"
    key="${cert_dir}/${CERT_DOMAIN}.key"
    [[ -s "$cert" && -s "$key" ]] || fail "ACME client did not install the certificate files."
    # 不改动 Nginx 配置，也不自动 reload；是否 reload 交由用户决定。
    # 续签后的 reload 仍由签发时的 --renew-hook 负责。
    print_cert_paths "$cert" "$key"
}

ssl_add() {
    local choice cert key ca webroot
    require_root
    require_nginx
    collect_cert_domains
    webroot="$(vhost_webroot "$CERT_DOMAIN")"
    printf "1: Let's Encrypt\n"
    printf '2: ZeroSSL\n'
    read -r -p "Enter 1 or 2: " choice
    case "$choice" in
        1) ca=letsencrypt ;;
        2) ca=zerossl ;;
        *) fail "Choose 1 or 2." ;;
    esac
    [[ "$CERT_DOMAIN" != \*.* ]] || fail "Wildcard certificates require lnmp dnsssl."
    issue_certificate webroot "" "$ca" "$webroot"
    cert="${SSL_DIR}/${CERT_DOMAIN}/fullchain.cer"
    key="${SSL_DIR}/${CERT_DOMAIN}/${CERT_DOMAIN}.key"
    print_config_hint "$cert" "$key"
}

dns_ssl() {
    local provider=$1 challenge=dns ca choice
    require_root
    require_nginx
    case "$provider" in
        ali|cf|dp|he|gd|aws|namecheap|namesilo) ;;
        *) fail "Unsupported DNS provider: $provider" ;;
    esac
    collect_cert_domains
    read -r -p "Use Let's Encrypt or ZeroSSL? [1/2]: " choice
    case "${choice:-1}" in
        1) ca=letsencrypt ;;
        2) ca=zerossl ;;
        *) fail "Choose 1 or 2." ;;
    esac
    collect_email
    issue_certificate "$challenge" "$provider" "$ca"
    print_config_hint "${SSL_DIR}/${CERT_DOMAIN}/fullchain.cer" \
        "${SSL_DIR}/${CERT_DOMAIN}/${CERT_DOMAIN}.key"
}

case "${1:-}" in
    --help|-h)
        usage
        exit 0
        ;;
    start|stop|restart|reload)
        require_root
        service_bundle "$1"
        ;;
    kill)
        require_root
        service_bundle stop
        ;;
    status)
        service_action status nginx
        service_action status mysql
        if [[ -n "$PHP_FPM_VERSION" ]]; then
            service_action status php-fpm
        else
            printf '%-8s %s\n' "PHP-FPM:" unknown
        fi
        ;;
    nginx|mysql|mariadb|php-fpm)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        require_root
        case "$2" in
            start|stop|restart|reload|kill|status) ;;
            *) usage >&2; exit 2 ;;
        esac
        service_action "$2" "$1"
        ;;
    vhost)
        case "${2:-}" in
            add) add_vhost ;;
            list) list_vhosts ;;
            del) delete_vhost ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    addons)
        shift
        exec /usr/local/bin/addons.sh "$@"
        ;;
    ssl)
        case "${2:-}" in
            add) ssl_add ;;
            auto-renew)
                require_root
                [[ -n "$ACME_BIN" ]] || fail "acme.sh is missing; install the Debian package with apt."
                ensure_acme_renewal_timer
                printf 'Automatic ACME renewal is enabled by lnmp-acme-renew.timer.\n'
                ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    dnsssl|dns|onlyssl)
        [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        dns_ssl "$2"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
